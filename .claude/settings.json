{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -b*)",
      "Bash(git switch -c*)",
      "Bash(gh pr *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/main-only.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/main-only.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-coauthor.sh"
          }
        ]
      }
    ]
  }
}
