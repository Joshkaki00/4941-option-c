# Copy to .env and fill in secrets. Never commit .env.
#   cp .env.example .env

# Required when LLM_PROVIDER=anthropic (default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1024

# anthropic | none  (none = retrieval-only / decline without hosted LLM)
LLM_PROVIDER=anthropic

# Postgres
DATABASE_URL=postgres:///handbook
TEST_DATABASE_URL=postgres:///handbook_test
DB_MAX_CONNS=10

# HTTP
LISTEN_ADDR=:8080
MAX_CONCURRENT_ASKS=8

# Embeddings: ollama | hash
EMBED_PROVIDER=hash
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Retrieval
TOP_K=5
MIN_SIMILARITY=0.5
RETRIEVE_TIMEOUT=2s

# Auth: use ONE of OIDC (prod) or DEV_AUTH_TOKENS (local)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_GROUPS_CLAIM=groups
DEV_AUTH_TOKENS=dev-alice|alice|all-employees;dev-bob|bob|all-employees;dev-hr|hr|all-employees,hr-only

HANDOFF_TEXT=Try HR, IT, or the handbook owner for this topic.
